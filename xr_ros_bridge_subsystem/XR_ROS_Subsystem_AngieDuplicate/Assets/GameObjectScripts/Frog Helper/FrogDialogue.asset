%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 0}
  m_Name: FrogDialogue
  m_EditorClassIdentifier: Assembly-CSharp::FrogDialogue
  introLines:
  - text: Ribbit! Oh thank goodness you are here! My name is Lily, and my frog friends
      are in trouble!
    audioClip: {fileID: 0}
  - text: An evil force has trapped them behind puzzles that only a clever human
      and a robot arm can solve!
    audioClip: {fileID: 0}
  - text: You will need to explore the puzzle rooms around you and find clues to
      help free them.
    audioClip: {fileID: 0}
  - text: Use the robot arm in the main room to interact with the puzzles. Point
      your RIGHT controller at the panel and pull the trigger to open the robot GUI.
    audioClip: {fileID: 0}
  - text: Good luck! Press the help button on your controller any time you need me.
      Now go save my friends! Ribbit!
    audioClip: {fileID: 0}
  mainRoomLines:
  - text: Use your RIGHT controller and point it at the panel on the robot. Pull
      the trigger to open the control interface!
    audioClip: {fileID: 0}
  - text: The GUI panel shows buttons for each puzzle. Press the puzzle number to
      move the robot arm to that puzzle!
    audioClip: {fileID: 0}
  - text: Reset Position brings the robot back to its starting spot. Reset Puzzle
      starts that puzzle over from scratch.
    audioClip: {fileID: 0}
  puzzle1Hints:
  - text: Hm... I wonder what that sign on the right says... something about following
      the cycle of life?
    audioClip: {fileID: 0}
  - text: My froggy friends jump in a certain order... maybe the numbers on the signs
      around the room hold a clue?
    audioClip: {fileID: 0}
  - text: Listen carefully... each frog croaks a different number of times. Could
      those numbers be a code?
    audioClip: {fileID: 0}
  puzzle2Hints:
  - text: My friends love jumping on lily pads! Can you follow their favourite path?
      Maybe try touching one?
    audioClip: {fileID: 0}
  - text: The lily pads light up in a special order... watch carefully and remember
      the sequence!
    audioClip: {fileID: 0}
  - text: The robot arm needs to follow the same path the lily pads showed you. Start
      from the top left corner!
    audioClip: {fileID: 0}
  puzzle3Hints:
  - text: Oh! Those are my friend's eggs! Can you pick them up? Try pointing at one
      and pulling the trigger!
    audioClip: {fileID: 0}
  - text: Each egg belongs on a special stand... look carefully at the symbols. Water
      goes with water, fire with fire!
    audioClip: {fileID: 0}
  - text: The stands have been moved around to trick you! Look around the room carefully
      for where they are hiding!
    audioClip: {fileID: 0}
