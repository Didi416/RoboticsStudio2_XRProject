  PluginText: "<ros2_control name=\"OnRobotGripper\" type=\"actuator\">\n  <hardware>\n   
    <plugin>onrobot_driver/RGHardwareInterface</plugin>\n    <param name=\"onrobot_type\">rg2</param>\n   
